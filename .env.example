# Copy to .env and fill in. Never commit .env.

# Claude — classify + draft. Get from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Notion internal integration token (https://www.notion.so/my-integrations)
# The integration must be shared with the Customer Complaints database.
NOTION_TOKEN=

# Target Notion database id. No default: a concrete id here would silently
# write every ticket into one specific workspace for anyone who forgets to
# set it. Copy the id from your database URL.
NOTION_DB_ID=

# Comma-separated support inbox address(es) — used to distinguish OUR replies
# from inbound customer mail in the thread. Fill in the real support address.
SUPPORT_ADDRESSES=support@example.com

# Slack notification. Off unless BOTH are set — the pipeline still writes
# Notion tickets without them, it just does not announce them.
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=

# Comma-separated colleague names. Mail naming one of these is routed to a
# human with NO draft attached. Empty by default: the guard cannot know who
# your colleagues are, so it does nothing until you fill this in.
EMPLOYEE_NAMES=

# SOP ids whose replies touch money. Guardrails force these to a human review
# regardless of how confident the draft looks. Must match the ids in
# data/sop_playbook.md.
MONEY_SOPS=A1,A2

# Optional model overrides (defaults set in config.py)
# CLASSIFY_MODEL=claude-haiku-4-5-20251001
# DRAFT_MODEL=claude-sonnet-4-6

# Live Gmail ingest (Phase 1) — IMAP app password on the support account.
# Requires 2-Step Verification ON, then generate an App Password.
GMAIL_USER=support@example.com
GMAIL_APP_PASSWORD=
